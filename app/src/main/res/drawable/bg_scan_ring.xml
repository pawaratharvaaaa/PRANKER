<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Outer subtle glow circle -->
    <item>
        <shape android:shape="oval">
            <size android:width="120dp" android:height="120dp"/>
            <solid android:color="#0A00E5FF"/>
            <stroke android:width="1.5dp" android:color="#3300E5FF"/>
        </shape>
    </item>
    <!-- Middle circle -->
    <item android:top="16dp" android:bottom="16dp" android:left="16dp" android:right="16dp">
        <shape android:shape="oval">
            <solid android:color="#1400E5FF"/>
            <stroke android:width="1.5dp" android:color="#6600E5FF"/>
        </shape>
    </item>
    <!-- Inner target circle -->
    <item android:top="32dp" android:bottom="32dp" android:left="32dp" android:right="32dp">
        <shape android:shape="oval">
            <solid android:color="#2E00E5FF"/>
            <stroke android:width="2dp" android:color="@color/cyan_neon"/>
        </shape>
    </item>
</layer-list>
